# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Qloo hackathon API key (sent as X-Api-Key to https://hackathon.api.qloo.com)
QLOO_API_KEY=
# Optional: override the Qloo server
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# Optional: stop network calls when fewer monthly requests remain (default 200; the quota is 10,000/month)
# QLOO_BUDGET_FLOOR=200

# Chat: Gemini first, Groq second, deterministic parsing if unavailable.
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_SMALL_MODEL=gemini-3.5-flash-lite
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Other registered vendors are available to explicit provider probes only.

# Optional authenticated on-demand builds (registry cities with public/geo geometry only)
# WORLD_BUILD_TOKEN=generate-a-long-random-operator-token
# BLOB_READ_WRITE_TOKEN=private-store-token
# Required conservative quota estimate to initialize the durable build ledger.
# Use the current verified monthly remaining count; build calls stop at a floor of at least 1000.
# WORLD_BUILD_QUOTA_REMAINING=
